.claude/

# IDE / editor metadata
.idea/
.vs/

# Delphi build output
*.dcu
*.dcp
*.exe
*.dll
*.bpl
*.lib
*.local
*.identcache
*.tvsconfig
*.dsv
*.dsk
*.~*
__history/
__recovery/
Win32/
Win64/
Debug/
Release/

# Rust build output
implementations/rust/target/
implementations/*/rust/target/

# Python build output
implementations/python/target/
implementations/python/.venv/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# maturin develop drops the compiled extension and PDBs into the
# python source tree for editable installs — never commit these.
implementations/python/python/osf/_osf*.pyd
implementations/python/python/osf/_osf*.so
implementations/python/python/osf/*.pdb

# maturin build produces wheels here.
implementations/python/dist/

# Stray local archive of the python examples — build/scratch artifact.
implementations/python/examples.zip

# Generated documentation PDFs (docs/scripts/docs-to-pdf.py).
# The Markdown sources under docs/ are the single source of truth.
docs/pdf-out/

# VS Code workspace metadata.
.vscode/

# Internal planning/spec scaffolding — not part of the published project.
# Kept on disk for ongoing development but never tracked or published:
# it carries local paths and would otherwise render as public doc pages.
# Shared out-of-band, not through this repo (no link/pointer here by design).
# NOTE: when syncing docs/ to the external Docusaurus site, exclude
# superpowers/ in the copy step (gitignored files are still on disk).
docs/superpowers/
