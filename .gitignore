# Python build output
implementations/python/target/
implementations/python/.venv/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# maturin develop drops the compiled extension and PDBs into the
# python source tree for editable installs — never commit these.
implementations/python/python/osf/_osf*.pyd
implementations/python/python/osf/_osf*.so
implementations/python/python/osf/*.pdb

# maturin build produces wheels here.
implementations/python/dist/

# Stray local archive of the python examples — build/scratch artifact.
implementations/python/examples.zip

# Generated documentation PDFs (docs/scripts/docs-to-pdf.py).
# The Markdown sources under docs/ are the single source of truth.
docs/pdf-out/

# VS Code workspace metadata.
.vscode/

# Internal superpowers planning/spec artefacts (per-phase agent plans).
# These are session-local development scaffolding, not public docs:
# they carry local machine paths and "for agentic workers" framing and
# would otherwise render as pages in the public Docusaurus site.
# Shared across machines + colleagues via a SEPARATE PRIVATE repo
# (optimeas/osf-superpowers) cloned into this gitignored path as an
# INDEPENDENT clone -- not a submodule, so no .gitmodules pointer leaks
# the private repo into this public one. Bootstrap on a new machine:
#     git clone https://github.com/optimeas/osf-superpowers.git docs/superpowers
# The previously-committed copies were purged from this repo's history
# in the git-filter-repo run (same pass as the unreleased Train field
# data).
# NOTE: when syncing docs/ to the external Docusaurus site, exclude
# superpowers/ in the copy step (gitignored files are still on disk).
docs/superpowers/
